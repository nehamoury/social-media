# Environment variables for Neon Database
# Get these from: https://console.neon.tech
# After creating a project, go to Dashboard > Connection Details

# Pooled connection (for queries) - use this for DATABASE_URL
DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Direct connection (for migrations) - use this for DIRECT_URL
DIRECT_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Port
PORT=5000
